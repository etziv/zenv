# .env for the server - copy to /root/<project>/.env (next to docker-compose.yml), fill the empty values,
# chmod 600, owner root. Never commit real values. LF line endings only (not CRLF).
# The GitHub token is NOT here: it lives alone in /root/<project>/.deploy-token (chmod 600), read only by
# deploy.sh, so it never reaches a container.

# Where Caddy listens on the host. Docker publishes around ufw: this address is the real limit.
# Loopback by default; the LAN address clients call (e.g. 192.168.1.20) when they reach it directly.
APP_BIND=127.0.0.1
# Check it is free first: ss -tlnp | grep ':<port> '
APP_PORT=8080

# Application settings read by the binary at start (examples; use what your app reads).
RUST_LOG=info
DATABASE_URL=

# Database container on this host: its docker network name (docker inspect <db> --format
# '{{range $k, $v := .NetworkSettings.Networks}}{{$k}} {{end}}'); uncomment `db` in compose. Host = container name.
# DB_NETWORK=

# Optional request on the new color before the switch (users do not see it yet) that proves the database route (/health does not):
# SMOKE_PATH=/api/<a cheap read>
SMOKE_PATH=
# Host name sent with it when the app checks Host (default localhost).
SMOKE_HOST=
