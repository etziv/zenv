# .env untuk server - copy ke /home/<project>/src/.env, isi nilai kosong.
# JANGAN commit nilai asli ke git. Pastikan LF line ending (bukan CRLF).

APP_NAME=MyApp
APP_ENV=production
APP_DEBUG=false
# Timezone app. Skeleton Laravel terbaru menulis 'timezone' => 'UTC' langsung di config/app.php, jadi var ini
# baru berlaku kalau config/app.php memakai env('APP_TIMEZONE', 'UTC'). Asia/Jakarta = WIB, UTC+7.
APP_TIMEZONE=Asia/Jakarta

# URL publik asli (IP:port server). WAJIB benar - kalau localhost, redirect
# & asset URL salah -> halaman blank.
APP_URL=http://SERVER_IP:8080

# Generate: openssl rand -base64 32  (lalu prefix "base64:")
APP_KEY=

# Host port mappings (cek port server bebas: ss -tlnp | grep ':<port> ').
APP_PORT=8080
REVERB_PORT=8090
DB_FORWARD_PORT=3307

# Database.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=myapp
DB_USERNAME=myapp
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Reverb (websocket). Generate key/secret: openssl rand -hex 32
REVERB_APP_ID=myapp
REVERB_APP_KEY=
REVERB_APP_SECRET=

# Vite-baked Reverb config - IP/port yang dilihat browser. WAJIB IP server.
VITE_REVERB_HOST=SERVER_IP
VITE_REVERB_PORT=8090
VITE_REVERB_SCHEME=http

# Alamat host tempat port app dipublikasikan. Docker melewati ufw, jadi alamat ini batas sebenarnya:
# IP LAN yang dibuka user, atau 127.0.0.1 di belakang proxy host.
APP_BIND=127.0.0.1

# Token GitHub TIDAK di sini: simpan sendirian di /root/<project>/.deploy-token (chmod 600); app PHP
# bisa membaca .env-nya sendiri.

# Bust build cache supaya rebuild fresh tiap deploy.
CACHEBUST=1
