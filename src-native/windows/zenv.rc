#include <winver.h>

#define ZENV_STR2(x) #x
#define ZENV_STR(x) ZENV_STR2(x)

1 ICON "../../src-tauri/icons/icon.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION ZENV_VERSION_BIN
PRODUCTVERSION ZENV_VERSION_BIN
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Zenv"
      VALUE "FileDescription", "Zenv"
      VALUE "FileVersion", ZENV_STR(ZENV_VERSION)
      VALUE "InternalName", "zenv"
      VALUE "OriginalFilename", "zenv.exe"
      VALUE "ProductName", "Zenv"
      VALUE "ProductVersion", ZENV_STR(ZENV_VERSION)
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
