# Generated by Zenv for FrankenPHP {{ version }} ({{ install_id }}).
# Regenerated whenever the sites it serves change; edit them in Zenv instead.
{
	admin 127.0.0.1:{{ admin_port }}
	auto_https off
	default_bind 127.0.0.1
	http_port {{ http_port }}
	frankenphp
	log {
		output file "{{ log_file }}"
	}
}
{% for site in sites %}

# {{ site.name }} ({{ site.id }})
http://{{ site.domain }}:{{ http_port }} {
	root * "{{ site.document_root }}"
	route {
		@hidden {
			path_regexp hidden (/\.|~[0-9])
			not path /.well-known/*
		}
		respond @hidden 403
		php_server
	}
}
{% endfor %}
{% if tailnet_sites %}

# Apps opened on the tailnet arrive with the tailnet host name; the front web
# server names the app in X-Zenv-Site.
http://:{{ http_port }} {
{% for site in tailnet_sites %}
	@app{{ loop.index }} header X-Zenv-Site {{ site.id }}
	handle @app{{ loop.index }} {
		root * "{{ site.document_root }}"
		route {
			@hidden {
				path_regexp hidden (/\.|~[0-9])
				not path /.well-known/*
			}
			respond @hidden 403
			php_server {
				# A tailnet visitor, though it arrives from 127.0.0.1, is not this computer.
				env REMOTE_ADDR {{ tailnet_peer }}
			}
		}
	}
{% endfor %}
}
{% endif %}
