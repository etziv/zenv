# Generated by Zenv for service "{{ service_name }}" ({{ service_id }}).
# Regenerated before every start; edit settings in Zenv.
# The MySQL installation's own my.ini (if any) is not used or modified.
[mysqld]
basedir="{{ basedir }}"
datadir="{{ datadir }}"
port={{ port }}
bind-address={{ bind }}
log-error="{{ logs_dir }}/mysql-error.log"
pid-file="{{ logs_dir }}/mysqld.pid"
character-set-server=utf8mb4
{% if modern %}
# No X Protocol listener: it would claim port 33060 for every instance.
mysqlx=OFF
# Never upgrade an older data folder implicitly; MySQL refuses to start instead.
upgrade=NONE
{% endif %}
{% if custom %}

# Your own settings (never overwritten by Zenv).
!include {{ custom }}
{% endif %}
