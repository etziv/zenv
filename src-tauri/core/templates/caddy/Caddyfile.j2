# ---------------------------------------------------------------------------
# Generated by Zenv for service "{{ service_name }}" ({{ service_id }}).
# This file is regenerated before every start; edit settings in Zenv.
# ---------------------------------------------------------------------------
{
	admin {{ admin }}
	auto_https off
	default_bind {{ bind }}
	http_port {{ port }}
{% if https %}
	https_port {{ https.port }}
{% endif %}
	grace_period 3s
{% if frankenphp %}
	frankenphp
{% endif %}
	log {
		output file "{{ logs_dir }}/caddy.log"
		format console
	}
}

# Default server: requests for unknown domains get Zenv's default page.
http://:{{ port }} {
	root * "{{ document_root }}"
	file_server
}
{% if https %}

https://:{{ https.port }} {
	tls "{{ https.cert }}" "{{ https.key }}"
	root * "{{ document_root }}"
	file_server
}
{% endif %}

# Local apps managed by Zenv.
import "{{ sites_dir }}/*.conf"
