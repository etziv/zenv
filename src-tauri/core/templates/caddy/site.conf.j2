# Generated by Zenv for site "{{ name }}" ({{ id }}).
# Regenerated whenever the site changes; edit the site in Zenv instead.
{% macro snippet(tailnet) %}
(zenv_site_{{ id }}{{ "_tailnet" if tailnet else "" }}) {
	log {
		output file "{{ logs_dir }}/{{ domain }}-access.log"
		format console
	}
	# Hidden files and folders (.env, .git/config, sub/.env) are never served,
	# nor Windows short names (GIT~1) that reach them under another name.
	@hidden {
		path_regexp hidden (/\.|~[0-9])
		not path /.well-known/*
	}
	respond @hidden 403
{% if kind == "static" %}
	root * "{{ document_root }}"
	# PHP is not executed for static sites; refuse sources instead of leaking them.
	@php path *.php *.php5 *.php7 *.phtml *.phar
	respond @php 403
	file_server
{% elif kind == "php_fastcgi" %}
	root * "{{ document_root }}"
	# PHP runs in Zenv's php-cgi workers for this site's PHP version.
	php_fastcgi{% for port in php_ports %} 127.0.0.1:{{ port }}{% endfor %}{% if tailnet %} {
		# A tailnet visitor, though it arrives from 127.0.0.1, is not this computer.
		env REMOTE_ADDR {{ tailnet_peer }}
	}{% endif %}

	file_server
{% else %}
	# The header names the app for a FrankenPHP backend whatever the host name.
	reverse_proxy {{ upstream }} {
		header_up X-Zenv-Site {{ id }}
{% if tailnet %}
		# A tailnet visitor, though it arrives from 127.0.0.1, is not this computer.
		header_up X-Forwarded-For {{ tailnet_peer }}
		header_up X-Real-IP {{ tailnet_peer }}
{% endif %}
	}
{% endif %}
}
{% endmacro %}
{% if not tailnet_only %}
{{ snippet(false) }}
{% endif %}
{% if tailnet_port %}
{{ snippet(true) }}
{% endif %}
{% if not tailnet_only %}

http://{{ domain }}:{{ port }} {
{% if tls and tls.redirect %}
	redir {{ tls.origin }}{uri} permanent
{% else %}
	import zenv_site_{{ id }}
{% endif %}
}
{% if tls %}

https://{{ domain }}:{{ tls.port }} {
	tls "{{ tls.cert }}" "{{ tls.key }}"
	import zenv_site_{{ id }}
}
{% endif %}
{% endif %}
{% if tailnet_port %}

# Opened on the tailnet: `tailscale serve` passes requests to this port. Only
# this computer's tailnet names are accepted: another host name is a web page
# elsewhere that pointed its name at this port (DNS rebinding).
http://:{{ tailnet_port }} {
{% if tailnet_hosts %}
	@elsewhere not host {{ tailnet_hosts | join(" ") }}
	respond @elsewhere "Unknown host" 421
{% else %}
	respond "This computer's tailnet names are not known yet; open the app on the tailnet again in Zenv" 421
{% endif %}
	import zenv_site_{{ id }}_tailnet
}
{% endif %}
