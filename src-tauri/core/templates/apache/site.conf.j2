# Generated by Zenv for site "{{ name }}" ({{ id }}).
# Regenerated whenever the site changes; edit the site in Zenv instead.
{% macro body(scheme, tailnet=false) %}
{% if kind == "static" %}
    DocumentRoot "{{ document_root }}"
    <Directory "{{ document_root }}">
        Options FollowSymLinks
        AllowOverride All
        Require all granted
    </Directory>
    # PHP is not executed for static sites, so PHP sources are refused rather
    # than sent as plain text.
    <FilesMatch "\.(php[0-9]?|phtml|phar)$">
        Require all denied
    </FilesMatch>
    # Hidden files and folders (.env, .git/config, sub/.env) are never served,
    # nor Windows short names (GIT~1) that reach them under another name.
    <LocationMatch "/\.(?!well-known(/|$))|~[0-9]">
        Require all denied
    </LocationMatch>
    <FilesMatch "^\.">
        Require all denied
    </FilesMatch>
{% elif kind == "php_fastcgi" %}
    DocumentRoot "{{ document_root }}"
    DirectoryIndex index.php index.html
    <Directory "{{ document_root }}">
        Options FollowSymLinks
        AllowOverride All
        Require all granted
    </Directory>
    # PHP runs in Zenv's php-cgi workers for this site's PHP version.
    <Proxy "balancer://php-{{ id }}">
{% for port in php_ports %}
        BalancerMember "fcgi://127.0.0.1:{{ port }}"
{% endfor %}
    </Proxy>
    <FilesMatch "\.php$">
        <If "-f %{REQUEST_FILENAME}">
            SetHandler "proxy:balancer://php-{{ id }}/"
        </If>
    </FilesMatch>
    ProxyFCGIBackendType GENERIC
    ProxyFCGISetEnvIf "true" SCRIPT_FILENAME "%{DOCUMENT_ROOT}%{reqenv:SCRIPT_NAME}"
{% if tailnet %}
    # A tailnet visitor, though it arrives from 127.0.0.1, is not this computer.
    ProxyFCGISetEnvIf "true" REMOTE_ADDR "{{ tailnet_peer }}"
{% endif %}
    # Hidden files and folders (.env, .git/config, sub/.env) are never served,
    # nor Windows short names (GIT~1) that reach them under another name.
    <LocationMatch "/\.(?!well-known(/|$))|~[0-9]">
        Require all denied
    </LocationMatch>
    <FilesMatch "^\.">
        Require all denied
    </FilesMatch>
{% else %}
    ProxyRequests Off
    ProxyPreserveHost On
    ProxyPass "/" "http://{{ upstream }}/"{% if websocket_upgrade %} upgrade=websocket{% endif %}

    ProxyPassReverse "/" "http://{{ upstream }}/"
    RequestHeader set X-Forwarded-Proto "{{ scheme }}"
{% if tailnet %}
    # A tailnet visitor, though it arrives from 127.0.0.1, is not this computer.
    ProxyAddHeaders Off
    RequestHeader set X-Forwarded-For "{{ tailnet_peer }}"
    RequestHeader set X-Real-IP "{{ tailnet_peer }}"
{% endif %}
{% endif %}
    ErrorLog "{{ logs_dir }}/{{ domain }}-error.log"
    CustomLog "{{ logs_dir }}/{{ domain }}-access.log" combined
{% endmacro %}
{% if not tailnet_only %}
<VirtualHost {{ vhost_address }}>
    ServerName {{ domain }}
{% if tls and tls.redirect %}
    Redirect permanent / "{{ tls.origin }}/"
{% else %}
{{ body("http") }}
{% endif %}
</VirtualHost>
{% if tls %}

<VirtualHost {{ tls.vhost_address }}>
    ServerName {{ domain }}
    SSLEngine on
    SSLCertificateFile "{{ tls.cert }}"
    SSLCertificateKeyFile "{{ tls.key }}"
{{ body("https") }}
</VirtualHost>
{% endif %}
{% endif %}
{% if tailnet_port %}

# Opened on the tailnet: `tailscale serve` passes http://<this computer>:{{ tailnet_port }}
# here; the header names the app for a FrankenPHP backend. Only this
# computer's tailnet names are accepted: another host name is a web page
# elsewhere that pointed its name at this port (DNS rebinding).
Listen 127.0.0.1:{{ tailnet_port }}
<VirtualHost 127.0.0.1:{{ tailnet_port }}>
    ServerName {{ domain }}
    RequestHeader set X-Zenv-Site "{{ id }}"
    <If "! %{HTTP_HOST} =~ m#^({{ tailnet_host_re }})(:[0-9]+)?$#i">
        Require all denied
    </If>
{{ body("http", true) }}
</VirtualHost>
{% endif %}
