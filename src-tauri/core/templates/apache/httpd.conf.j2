# ---------------------------------------------------------------------------
# Generated by Zenv for service "{{ service_name }}" ({{ service_id }}).
# This file is regenerated before every start; edit settings in Zenv.
# The Apache installation's own conf/httpd.conf is not used or modified.
# ---------------------------------------------------------------------------
Define SRVROOT "{{ server_root }}"
ServerRoot "${SRVROOT}"

Listen {{ listen }}
{% if https %}
Listen {{ https.listen }}
{% endif %}
ServerName localhost:{{ port }}
ServerAdmin admin@localhost

{% for module in modules %}
LoadModule {{ module.name }} modules/{{ module.file }}
{% endfor %}

PidFile "{{ logs_dir }}/httpd.pid"
ErrorLog "{{ logs_dir }}/error.log"
LogLevel warn
LogFormat "%h %l %u %t \"%r\" %>s %b \"%{Referer}i\" \"%{User-Agent}i\"" combined
CustomLog "{{ logs_dir }}/access.log" combined

TypesConfig conf/mime.types
AddType application/x-compress .Z
AddType application/x-gzip .gz .tgz
ServerTokens Prod
KeepAliveTimeout 3
ServerSignature Off
TraceEnable off
AcceptFilter http none
AcceptFilter https none
EnableSendfile off
EnableMMAP off

<Directory />
    AllowOverride None
    Require all denied
</Directory>

<Files ".ht*">
    Require all denied
</Files>

DocumentRoot "{{ document_root }}"
<Directory "{{ document_root }}">
    Options FollowSymLinks
    AllowOverride All
    Require all granted
</Directory>

DirectoryIndex index.html index.htm

# Default virtual host: requests for unknown domains get the page above.
# It must come before the site includes so Apache uses it as the fallback.
<VirtualHost {{ vhost_address }}>
    ServerName localhost
    DocumentRoot "{{ document_root }}"
</VirtualHost>

{% if https %}
# HTTPS with certificates from Zenv's local certificate authority.
SSLSessionCache "shmcb:{{ logs_dir }}/ssl_scache(512000)"
SSLProtocol all -SSLv3 -TLSv1 -TLSv1.1
SSLHonorCipherOrder off
<VirtualHost {{ https.vhost_address }}>
    ServerName localhost
    DocumentRoot "{{ document_root }}"
    SSLEngine on
    SSLCertificateFile "{{ https.cert }}"
    SSLCertificateKeyFile "{{ https.key }}"
</VirtualHost>

{% endif %}
# Local sites managed by Zenv.
IncludeOptional "{{ sites_dir }}/*.conf"
