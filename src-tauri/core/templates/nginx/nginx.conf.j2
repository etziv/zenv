# ---------------------------------------------------------------------------
# Generated by Zenv for service "{{ service_name }}" ({{ service_id }}).
# This file is regenerated before every start; edit settings in Zenv.
# The Nginx installation's own conf/nginx.conf is not used or modified.
# ---------------------------------------------------------------------------
# nginx/Windows uses select() and handles one worker well.
worker_processes 1;
pid "{{ logs_dir }}/nginx.pid";
error_log "{{ logs_dir }}/error.log" warn;

events {
    worker_connections 1024;
}

http {
    include "{{ install_root }}/conf/mime.types";
    default_type application/octet-stream;
    log_format zenv '$remote_addr - $remote_user [$time_local] "$request" $status $body_bytes_sent "$http_referer" "$http_user_agent"';
    access_log "{{ logs_dir }}/access.log" zenv;
    keepalive_timeout 15;
    client_max_body_size 256m;
    # Room for long host names (for example MagicDNS names on the tailnet).
    server_names_hash_bucket_size 128;
    server_tokens off;

    client_body_temp_path "{{ temp_dir }}/client_body";
    proxy_temp_path "{{ temp_dir }}/proxy";
    fastcgi_temp_path "{{ temp_dir }}/fastcgi";
    uwsgi_temp_path "{{ temp_dir }}/uwsgi";
    scgi_temp_path "{{ temp_dir }}/scgi";

    map $http_upgrade $connection_upgrade {
        default upgrade;
        '' close;
    }

    # Default server: requests for unknown domains get Zenv's default page.
    server {
        listen {{ listen }} default_server;
        server_name localhost;
        root "{{ document_root }}";
        index index.html index.htm;
{% if https %}
        listen {{ https.listen }} ssl default_server;
        ssl_certificate "{{ https.cert }}";
        ssl_certificate_key "{{ https.key }}";
{% endif %}
    }
{% if https %}

    ssl_protocols TLSv1.2 TLSv1.3;
{% endif %}

    # Local sites managed by Zenv.
    include "{{ sites_dir }}/*.conf";
}
