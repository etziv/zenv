# Generated by Zenv for site "{{ name }}" ({{ id }}).
# Regenerated whenever the site changes; edit the site in Zenv instead.
{% if kind == "php_fastcgi" %}
upstream {{ upstream_name }} {
{% for port in php_ports %}
    server 127.0.0.1:{{ port }};
{% endfor %}
}

{% endif %}
server {
{% if not tailnet_only %}
    listen {{ listen }};
{% endif %}
{% if tailnet_port %}
    # Opened on the tailnet: `tailscale serve` passes requests to this port.
    listen 127.0.0.1:{{ tailnet_port }};
{% endif %}
    server_name {{ domain }};
{% if tailnet_port %}
    # Tailnet visitors: only this computer's tailnet names (another host name
    # is a web page elsewhere that pointed its name at this port), and not
    # taken for this computer although they arrive from 127.0.0.1.
    set $zenv_peer $remote_addr;
    if ($server_port = {{ tailnet_port }}) {
        set $zenv_peer {{ tailnet_peer }};
    }
    set $zenv_port_host "$server_port:$host";
    if ($zenv_port_host ~* "^{{ tailnet_port }}:(?!({{ tailnet_host_re }})$)") {
        return 421;
    }
{% endif %}
{% if tls %}
    listen {{ tls.listen }} ssl;
    ssl_certificate "{{ tls.cert }}";
    ssl_certificate_key "{{ tls.key }}";
{% if tls.redirect %}
{% if tailnet_port %}
    # Tailnet visitors stay on plain HTTP (Tailscale already encrypts it).
    set $zenv_redirect $scheme;
    if ($server_port = {{ tailnet_port }}) {
        set $zenv_redirect tailnet;
    }
    if ($zenv_redirect = http) {
        return 301 {{ tls.origin }}$request_uri;
    }
{% else %}
    if ($scheme = http) {
        return 301 {{ tls.origin }}$request_uri;
    }
{% endif %}
{% endif %}
{% endif %}
    access_log "{{ logs_dir }}/{{ domain }}-access.log" zenv;
    error_log "{{ logs_dir }}/{{ domain }}-error.log" warn;

    # Dotfiles such as .env are never served.
    location ~ /\.(?!well-known) {
        deny all;
    }
{% if kind == "static" %}
    root "{{ document_root }}";
    index index.html index.htm;
    # PHP is not executed for static sites; refuse sources instead of leaking them.
    location ~ \.(php[0-9]?|phtml|phar)$ {
        deny all;
    }
    location / {
        try_files $uri $uri/ =404;
    }
{% elif kind == "php_fastcgi" %}
    root "{{ document_root }}";
    index index.php index.html;
    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }
    # PHP runs in Zenv's php-cgi workers for this site's PHP version.
    location ~ \.php$ {
        try_files $uri =404;
        fastcgi_pass {{ upstream_name }};
        fastcgi_index index.php;
        include "{{ install_root }}/conf/fastcgi_params";
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
{% if tailnet_port %}
        fastcgi_param REMOTE_ADDR $zenv_peer;
{% endif %}
    }
{% else %}
    location / {
        proxy_pass http://{{ upstream }};
        proxy_http_version 1.1;
        # The host name exactly as asked (with its port), so apps build correct links.
        proxy_set_header Host $http_host;
{% if tailnet_port %}
        proxy_set_header X-Real-IP $zenv_peer;
        proxy_set_header X-Forwarded-For $zenv_peer;
{% else %}
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
{% endif %}
        proxy_set_header X-Forwarded-Proto $scheme;
        # Names the app for a FrankenPHP backend whatever the host name.
        proxy_set_header X-Zenv-Site {{ id }};
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
{% endif %}
}
